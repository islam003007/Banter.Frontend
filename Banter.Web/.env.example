# Local development uses the Vite proxy by default.
# VITE_API_TARGET=http://localhost:8080

# Production only: absolute API origin and SignalR hub URL.
# Leave both unset locally so the proxy handles /api and /hubs.
# VITE_API_BASE_URL=https://api.example.com
# VITE_HUB_URL=https://api.example.com/hubs/chat
